# ---------------------------------------------------------------------------
# KAGE — environment template.  Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Public project URL and anon (public) key. Safe to expose to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_PUBLIC_API_KEY=your-anon-public-key

# Server-only. Full database access. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_API_KEY=your-service-role-key

# Management API token (starts with sbp_). Used only by scripts/db-push.mjs.
SUPABASE_ACCESS_TOKENS=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client-side aliases (Vite only exposes vars prefixed with VITE_).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Origin of the deployed BFF (server/). Leave EMPTY for local dev so Vite's
# proxy forwards /api -> http://localhost:8787. On static hosting such as
# Cloudflare Pages, set it to the BFF URL, e.g. https://kage-api.onrender.com
VITE_API_BASE_URL=

# --- Gemini API (server-only; used by server/) ------------------------------
# key1 is primary, key2 is the automatic fallback.
GEMINI_API_KEY1=your-primary-gemini-api-key
GEMINI_API_KEY2=your-fallback-gemini-api-key

# Model routing
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# --- Server -----------------------------------------------------------------
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- GitHub (used only for the one-off push; can be removed afterwards) -----
REPO_ULR=https://github.com/your-user/your-repo.git
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxx
